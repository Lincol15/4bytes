-- Recolecciones registradas en el dispositivo que todavía no llegaron al servidor.
-- estado: PENDIENTE (se enviará al haber conexión) o ERROR (el servidor la rechazó).
-- client_uuid evita duplicados si un envío se repite.
CREATE TABLE recoleccion_pendiente (
    client_uuid TEXT NOT NULL PRIMARY KEY,
    id_usuario TEXT NOT NULL,
    id_productor TEXT NOT NULL,
    nombre_productor TEXT,
    zona TEXT,
    litros REAL NOT NULL,
    observacion TEXT,
    id_parada TEXT,
    registrado_en INTEGER NOT NULL,
    estado TEXT NOT NULL DEFAULT 'PENDIENTE',
    error TEXT,
    intentos INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX recoleccion_pendiente_usuario ON recoleccion_pendiente (id_usuario, registrado_en);

deUsuario:
SELECT * FROM recoleccion_pendiente WHERE id_usuario = ? ORDER BY registrado_en DESC;

porEnviar:
SELECT * FROM recoleccion_pendiente WHERE id_usuario = ? AND estado = 'PENDIENTE' ORDER BY registrado_en ASC;

insertar:
INSERT INTO recoleccion_pendiente (
    client_uuid, id_usuario, id_productor, nombre_productor, zona, litros, observacion, id_parada, registrado_en
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

marcarError:
UPDATE recoleccion_pendiente SET estado = 'ERROR', error = ?, intentos = intentos + 1 WHERE client_uuid = ?;

sumarIntento:
UPDATE recoleccion_pendiente SET intentos = intentos + 1 WHERE client_uuid = ?;

reintentar:
UPDATE recoleccion_pendiente SET estado = 'PENDIENTE', error = NULL WHERE client_uuid = ?;

eliminar:
DELETE FROM recoleccion_pendiente WHERE client_uuid = ?;
