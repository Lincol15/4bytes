<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo para builds debug: permite HTTP sin cifrar hacia el servidor Laravel local.
    10.0.2.2 = equipo anfitrión visto desde el emulador de Android.
    Para un celular físico, agrega aquí la IP LAN del equipo (p. ej. 192.168.1.50).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
